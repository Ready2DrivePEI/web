# ==============================================================================
# Ready2Drive LMS & Website - Environment Variables
# ==============================================================================
# Instructions:
# 1. Copy this file to create your local environment: cp .env.example .env.local
# 2. Replace the placeholder values with your project credentials.
# 3. For production deployments (e.g., Vercel), add these same keys in Project Settings.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE (Authentication & Database)
# Docs: https://supabase.com/docs/guides/auth/server-side/nextjs
# ------------------------------------------------------------------------------

# Project URL: Found in Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Public Anon Key: Safe for browser exposure; enforces Row Level Security (RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-Only Service Role Key: NEVER expose to browser. Bypasses RLS for admin tasks.
# Found in Supabase Dashboard -> Project Settings -> API -> service_role secret
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# (Optional backward-compatibility aliases)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key
SUPABASE_URL=https://your-project-ref.supabase.co

# ------------------------------------------------------------------------------
# 2. LMS COURSE PROGRESSION LOCKS
# ------------------------------------------------------------------------------
# Set to 'true' in development to unlock all chapters for testing & previewing.
# Set to 'false' in production to enforce linear chapter & quiz completion.
NEXT_PUBLIC_LMS_BYPASS_LOCKS=false

# ------------------------------------------------------------------------------
# 3. RESEND (Transactional Emails)
# Docs: https://resend.com/docs/introduction
# ------------------------------------------------------------------------------
# API Key for sending contact inquiry alerts & course completion notifications.
# Found in Resend Dashboard -> API Keys
RESEND_API_KEY=re_your_resend_api_key
